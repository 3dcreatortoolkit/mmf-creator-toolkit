{
  "manifest_version": 3,
  "name": "3D Creator Toolkit: MMF CSV Exporter",
  "version": "0.0.9",
  "description": "Export a creator's MyMiniFactory store listings and collections to CSV using your signed-in browser session.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "webRequest",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://*.myminifactory.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.myminifactory.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "3D Creator Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
